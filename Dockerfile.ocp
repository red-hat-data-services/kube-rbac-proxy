# Digest-pinned for reproducible, reviewable builder updates: the go-toolset
# 1.27 tag floats across rebuilds (which once moved Go 1.26.10 to 1.27.3 under
# a moving reference and triggered the RHAI-29798 crash loop). Bump the digest
# deliberately, with CI, when picking up a new builder build.
# go-toolset 1.27 (go1.27.3 at the time of pinning)
ARG GOLANG_BUILDER_DIGEST=sha256:23c7cb17e9c53a65f9ab01f2edf1a4e07c9a9dc2258ed63d69e06925e7cea381

FROM registry.access.redhat.com/ubi9/go-toolset@$GOLANG_BUILDER_DIGEST AS builder
USER root
WORKDIR /go/src/github.com/brancz/kube-rbac-proxy
COPY . .
ENV GO111MODULE=on
# Never download a newer toolchain in image builds: the go directive is
# satisfied by the pinned builder image's Go, and ART/air-gapped builds must
# not fetch toolchains over the network.
ENV GOTOOLCHAIN=local
# Generate vendor at build time when not committed (ART / air-gapped builds)
RUN go mod vendor
# GOFLAGS is needed to build image without accessing external sources, mostly to comply with ART policies
ENV GOFLAGS="-mod=vendor"
RUN GITHUB_URL=github.com/openshift/kube-rbac-proxy VERSION="$(cat VERSION)" make build && \
    cp _output/kube-rbac-proxy-"$(go env GOOS)"-"$(go env GOARCH)" _output/kube-rbac-proxy

# Final base floats on the 4.22 stream tag: its digest is only resolvable
# with OpenShift CI registry credentials, and ART repoints this tag as the
# release stream moves. Builder images above are digest-pinned.
FROM registry.ci.openshift.org/ocp/4.22:base-rhel9
LABEL io.k8s.display-name="kube-rbac-proxy" \
      io.k8s.description="This is a proxy, that can perform Kubernetes RBAC authorization." \
      io.openshift.tags="openshift,kubernetes" \
      summary="" \
      maintainer="OpenShift Monitoring Team <team-monitoring@redhat.com>"

ARG FROM_DIRECTORY=/go/src/github.com/brancz/kube-rbac-proxy
COPY --from=builder ${FROM_DIRECTORY}/_output/kube-rbac-proxy  /usr/bin/kube-rbac-proxy

USER 65534
EXPOSE 8080
ENTRYPOINT ["/usr/bin/kube-rbac-proxy"]
